# ==============================================================================
# AI Document Intelligence Assistant — Environment Configuration
# ==============================================================================

# LLM Providers (Provide at least one, or use Offline Demo Mode)
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Vector Store Settings
# Options: "chroma" or "faiss"
VECTOR_STORE_TYPE="chroma"
PERSIST_DIRECTORY="./data/chroma_db"
FAISS_INDEX_PATH="./data/faiss_index"

# Default Model Configuration
OPENAI_MODEL_NAME="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
GOOGLE_MODEL_NAME="gemini-1.5-flash"

# Default RAG Pipeline Hyperparameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=200
DEFAULT_TOP_K=4
DEFAULT_RETRIEVAL_TYPE="similarity"  # "similarity" or "mmr"
DEFAULT_TEMPERATURE=0.0
